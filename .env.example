# Copy to .env.local and adjust. Everything here has a working default, so the
# app also runs without any env file at all.

# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
DEMO_PASSWORD=

# Public: inlined into the client bundle at build time. Never put secrets here.
NEXT_PUBLIC_CLINIC_NAME=

# Used to build absolute URLs for link previews and the sitemap.
NEXT_PUBLIC_SITE_URL=
